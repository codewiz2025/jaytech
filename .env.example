# Contact form delivery via Resend (https://resend.com)
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered (defaults to admin.jaytech@gmail.com)
CONTACT_TO_EMAIL=admin.jaytech@gmail.com

# Sender address.
# Leave unset to use Resend's test sender (onboarding@resend.dev).
# That test sender can ONLY deliver to the email address you signed up to Resend with.
# After you verify a domain in Resend, set e.g.:
# CONTACT_FROM_EMAIL=JayTech Digitals <enquiries@jaytech.online>
CONTACT_FROM_EMAIL=

# Public site URL used for SEO metadata
NEXT_PUBLIC_SITE_URL=https://www.jaytech.online
